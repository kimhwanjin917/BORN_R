<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>리치 텍스트 입력 (이메일 본문)</masterLabel>
    <description>Flow 화면에서 서식 있는 이메일 본문(HTML)을 입력받는 컴포넌트</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="label" type="String" label="라벨" role="inputOnly"/>
            <property name="value" type="String" label="본문(HTML)" description="기본값을 넣으면 미리 채워지고, 사용자가 수정한 HTML이 돌아옵니다"/>
            <property name="required" type="Boolean" label="필수 입력" role="inputOnly"/>
            <property name="placeholder" type="String" label="플레이스홀더" role="inputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>