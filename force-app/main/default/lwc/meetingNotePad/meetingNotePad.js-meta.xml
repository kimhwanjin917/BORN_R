<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Meeting Note Pad</masterLabel>
    <description>미팅 메모, 수수료 조건 계산, Agentforce 추천과 후속 질문을 제공하는 Flow 화면 컴포넌트</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property
                name="rawContent"
                type="String"
                label="미팅 원문"
                role="outputOnly"
            />
            <property
                name="followUpQuestion"
                type="String"
                label="추가 질문"
                role="outputOnly"
            />
            <property
                name="recommendation"
                type="String"
                label="에이전트 추천"
                description="Flow 또는 Agentforce 처리 결과를 LWC에 전달"
                role="inputOnly"
            />
            <property
                name="normalizedRecommendation"
                type="String"
                label="정규화된 에이전트 추천"
                description="Agentforce 응답에서 사용자에게 표시할 추천 메시지만 추출"
                role="outputOnly"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>