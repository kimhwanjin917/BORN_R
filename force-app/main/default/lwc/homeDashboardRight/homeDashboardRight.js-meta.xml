<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>홈 대시보드 오른쪽 영역</masterLabel>
    <description>홈 탭에 따라 영업 일정·만기 알림 또는 우선순위를 표시합니다.</description>
    <targets>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__HomePage">
            <property
                name="flowApiName"
                type="String"
                label="미팅 시작 Flow API 명"
                default="Meeting_Session"
            />
            <property
                name="maxRows"
                type="Integer"
                label="우선순위 각 섹션 표시 수"
                default="3"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>