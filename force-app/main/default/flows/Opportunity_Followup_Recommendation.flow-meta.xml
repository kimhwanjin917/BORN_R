            <fieldText>&lt;p&gt;&lt;strong&gt;RM 어시스턴트 후속 추천&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!Ask_Agent.reply}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
