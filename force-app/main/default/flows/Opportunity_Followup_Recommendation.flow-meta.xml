<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Ask_Agent</name>
        <label>RM 어시스턴트 후속 추천 요청 (Agent API)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>AgentApiClient</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Agent_OK</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Assign_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>utterance</name>
            <value>
                <elementReference>Utterance</elementReference>
            </value>
        </inputParameters>
        <nameSegment>AgentApiClient</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>Generate_Pdf</name>
        <label>후속 추천 PDF 생성·첨부</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>FollowupRecommendationPdfController</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Pdf_OK</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Assign_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>opportunityId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recommendationText</name>
            <value>
                <elementReference>Ask_Agent.reply</elementReference>
            </value>
        </inputParameters>
        <nameSegment>FollowupRecommendationPdfController</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Agent_Error</name>
        <label>에이전트 오류 담기</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varError</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Ask_Agent.errorMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Error_Screen</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Fault</name>
        <label>오류 메시지 담기</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varError</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Error_Screen</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Pdf_Error</name>
        <label>PDF 오류 담기</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varError</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Generate_Pdf.errorMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Error_Screen</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Agent_OK</name>
        <label>에이전트 응답 성공?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Agent_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>실패</defaultConnectorLabel>
        <rules>
            <name>Agent_Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Ask_Agent.isSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Recommendation_Screen</targetReference>
            </connector>
            <label>성공</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pdf_OK</name>
        <label>PDF 생성 성공?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Pdf_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>실패</defaultConnectorLabel>
        <rules>
            <name>Pdf_Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Generate_Pdf.isSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Done_Pdf_Screen</targetReference>
            </connector>
            <label>성공</label>
        </rules>
    </decisions>
    <decisions>
        <name>Wants_Pdf</name>
        <label>PDF 생성하시겠습니까?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Done_No_Pdf_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>아니오</defaultConnectorLabel>
        <rules>
            <name>Yes_Pdf</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Generate_Pdf_Toggle</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Generate_Pdf</targetReference>
            </connector>
            <label>예</label>
        </rules>
    </decisions>
    <description>docs/51 D구간 후속 추천: Closed Won 기회 화면 버튼 → Agent API로 RM_Assistant에게 후속 추천(업셀·크로스셀) 요청 → 결과 표시 → &quot;크로스셀 추천 PDF 생성하시겠습니까?&quot; → 예 → PDF 생성·첨부 → 끝. Slack 발송·후속 Opp 생성 없음.</description>
    <environments>Default</environments>
    <formulas>
        <name>Utterance</name>
        <dataType>String</dataType>
        <expression>&quot;기회 Id &quot; &amp; {!recordId} &amp; &quot; 의 고객에게 후속 추천을 만들어줘. 기회 검색 없이 이 Id 를 그대로 쓰고, 후속 추천 재료 조회와 상품 카탈로그 조회를 실행한 뒤 ① 고객·기준 상품·만기 요약 ② 업셀/재계약 제안과 근거 수치 ③ 크로스셀 제안과 근거 수치 ④ 다음 행동 순서로, 제안서에 그대로 실을 수 있는 완결된 문장으로 답해줘.&quot;</expression>
    </formulas>
    <interviewLabel>후속 추천 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity: 후속 추천 (에이전트 + PDF)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
