    <screens>
        <name>Review_Screen</name>
        <label>RP 제안 검토 후 발송</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Share_To_Slack</targetReference>
        </connector>
        <fields>
            <name>Review_Intro</name>
            <fieldText>&lt;p&gt;받는 고객: &lt;b&gt;{!Get_Lead.Name}&lt;/b&gt; ({!Get_Lead.Company})&lt;/p&gt;&lt;p&gt;보낼 채널: &lt;a href=&quot;{!Get_Lead.Slack_Channel_Link__c}&quot; target=&quot;_blank&quot;&gt;{!Get_Lead.Slack_Channel_Link__c}&lt;/a&gt;&lt;/p&gt;&lt;p&gt;아래 제안 메시지는 AI(프롬프트 템플릿)가 상품 카탈로그를 근거로 작성한 초안입니다. 내용을 확인·수정한 뒤 &lt;b&gt;[Slack으로 보내기]&lt;/b&gt;를 누르면 채널에 메시지가 게시되고, 이 Lead에 첨부된 파일(Files)이 함께 공유됩니다.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Proposal_Text_Input</name>
            <defaultValue>
                <elementReference>varProposalText</elementReference>
            </defaultValue>
            <fieldText>RP 제안 메시지 (Slack에 그대로 게시됩니다)</fieldText>
