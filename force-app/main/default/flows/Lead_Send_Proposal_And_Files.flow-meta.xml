            <targetReference>Set_Output_No_Channel</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>채널 없음</defaultConnectorLabel>
        <rules>
            <name>Channel_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.Slack_Channel_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Generate_Proposal</targetReference>
            </connector>
            <label>채널 있음</label>
        </rules>
    </decisions>
