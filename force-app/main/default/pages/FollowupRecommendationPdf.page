<apex:page controller="FollowupRecommendationPdfController" renderAs="pdf" applyBodyTag="false" applyHtmlTag="false" showHeader="false" sidebar="false" standardStylesheets="false">
<!-- docs/51 후속 추천 PDF. 한글은 VF PDF 렌더러 내장 'Arial Unicode MS' 로 출력 -->
<html>
<head>
<style type="text/css">
    @page { size: A4; margin: 18mm 16mm; @bottom-center { content: "근본증권 · 후속 추천 · " counter(page) " / " counter(pages); font-family: 'Arial Unicode MS'; font-size: 9pt; color: #666; } }
    body { font-family: 'Arial Unicode MS'; font-size: 11pt; color: #1a1a1a; }
    h1 { font-size: 18pt; color: #0b3d91; margin: 0 0 4pt 0; }
    .sub { font-size: 10pt; color: #555; margin-bottom: 14pt; }
    table.meta { border-collapse: collapse; width: 100%; margin-bottom: 14pt; }
    table.meta td { border: 1px solid #ccd; padding: 5pt 7pt; font-size: 10pt; }
    table.meta td.k { background: #eef2fb; width: 24%; color: #0b3d91; }
    .box { border: 1px solid #ccd; padding: 10pt 12pt; }
    .line { margin: 0 0 5pt 0; line-height: 1.45; }
    .note { margin-top: 14pt; font-size: 9pt; color: #777; }
</style>
</head>
<body>
    <h1>후속 상품 추천 제안서</h1>
    <div class="sub">근본증권 법인영업 · RM 어시스턴트 분석 기반 · 생성 {!generatedAt}</div>
    <table class="meta">
        <tr><td class="k">고객사</td><td>{!opp.Account.Name}</td><td class="k">산업군</td><td>{!opp.Account.Industry}</td></tr>
        <tr><td class="k">기존 거래</td><td>{!opp.Name}</td><td class="k">기준 상품</td><td>{!opp.Primary_Product__r.Name}</td></tr>
        <tr><td class="k">담당 RM</td><td colspan="3">{!opp.Owner.Name}</td></tr>
    </table>
    <div class="box">
        <apex:repeat value="{!recommendationLines}" var="l">
            <p class="line"><apex:outputText value="{!l}"/></p>
        </apex:repeat>
    </div>
    <div class="note">본 제안서의 수치는 Salesforce 에 기록된 DART 재무·외부시그널·보유상품 데이터를 RM 어시스턴트가 인용한 것이며, 최종 조건은 담당 RM 확인 후 확정됩니다.</div>
</body>
</html>
</apex:page>